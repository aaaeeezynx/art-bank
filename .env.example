# ── 藝術銀行典藏管理系統 環境變數範本 ──────────────────────────────
# 複製本檔案為 .env 並填入實際值後重啟 dev server

# 資料庫連線（MySQL）- 必填，登入與作品資料都需此設定
DATABASE_URL=mysql://使用者:密碼@localhost:3306/artbank

# Session JWT 密鑰 - 必填，請用一串隨機長字串
JWT_SECRET=請換成一段隨機的長字串

# ── Email/密碼登入 ──────────────────────────────────────────────
# 不需要額外設定，以上 DATABASE_URL 與 JWT_SECRET 即可使用

# ── 以下為模板預設項，通常不需更動 ───────────────────────────────
# 應用 ID
VITE_APP_ID=artbank-collection
# 管理員 openId（設定後該使用者自動成為 admin）
OWNER_OPEN_ID=
